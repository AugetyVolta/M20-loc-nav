# ROS 2 workspace build artifacts
build/
install/
log/

# Rosbag recordings and runtime data
bags/
*.bag
*.db3
*.mcap

# Python / editor / OS noise
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.vscode/
.idea/
*.swp
*~
.DS_Store

# Runtime logs and generated diagnostics
*.log
*.csv
*.tmp
core
core.*

# Large ML checkpoints / exports. Use Git LFS or external storage if needed.
*.pt
*.pth
*.onnx
*.engine
*.pkl

# Python packaging/build metadata copied into source trees
*.egg-info/
src/**/hook/

# Stable RL checkpoints are required for deployment on this branch.
!src/move/ckpts/
!src/move/ckpts/**

# Large upstream demo/doc assets; not needed for robot deployment.
src/fast_lio/doc/
src/fast_lio_map/doc/

# Generated map/debug outputs. Keep checked-in map YAML/PGM/PCD only when
# intentionally added with `git add -f`.
*.ply
PCD/
maps/fastlio/Scans/
maps/fastlio/odom_poses.txt
maps/fastlio/optimized_poses.txt
maps/fastlio/times.txt
maps/*

# Vendored PCT planner build/runtime outputs. The source is tracked, but
# generated pybind libraries and tomogram pickles should be rebuilt locally.
src/global_path_planning/planner/lib/build/
src/global_path_planning/planner/lib/*.so
src/global_path_planning/planner/lib/3rdparty/gtsam-4.1.1/build/
src/global_path_planning/planner/lib/3rdparty/gtsam-4.1.1/install/
src/global_path_planning/planner/lib/3rdparty/osqp/build/
src/global_path_planning/planner/lib/3rdparty/osqp/install/
src/global_path_planning/rsc/tomogram/*.pickle
!src/global_path_planning/**/*.csv
