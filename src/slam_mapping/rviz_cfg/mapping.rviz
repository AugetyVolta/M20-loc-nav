Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /Path1
        - /Path2
        - /Odometry1
        - /Odometry2
        - /PointCloud21
        - /PointCloud22
      Splitter Ratio: 0.5
    Tree Height: 700
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/Path
      Color: 0; 255; 0
      Enabled: true
      Line Style: Lines
      Line Width: 0.03
      Name: Path (Front-end Raw - Green)
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /path
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/Path
      Color: 0; 170; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.06
      Name: Path (Back-end Optimized - Blue)
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /aft_pgo_path
      Value: true
    - Angle Tolerance: 0.1
      Class: rviz_default_plugins/Odometry
      Covariance:
        Value: false
      Enabled: true
      Keep: 1
      Name: Odom (Raw - Red)
      Shape:
        Color: 255; 0; 0
      Topic:
        Value: /Odometry
      Value: true
    - Angle Tolerance: 0.1
      Class: rviz_default_plugins/Odometry
      Covariance:
        Value: false
      Enabled: true
      Keep: 1
      Name: Odom (Optimized - Yellow)
      Shape:
        Color: 255; 255; 0
      Topic:
        Value: /aft_pgo_odom
      Value: true
    - Alpha: 0.5
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: Intensity
      Axis: Z
      Enabled: true
      Name: Global Optimized Map (Rainbow)
      Size (Pixels): 1
      Style: Points
      Topic:
        Durability Policy: Volatile
        Value: /aft_pgo_map
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: Intensity
      Enabled: true
      Invert Rainbow: true
      Name: Current Scan
      Size (Pixels): 3
      Style: Points
      Topic:
        Value: /cloud_registered_body
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: camera_init
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
    Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 80
      Name: Current View
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
Window Geometry:
  Displays:
    collapsed: false
  Height: 600
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1000